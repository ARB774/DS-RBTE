[Unit]
Description=RBTE portal mail queue
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=rbteportal
Group=rbteportal
WorkingDirectory=/opt/rbte-portal/current
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/rbte-portal/current/.venv/bin/python manage.py send_portal_mail
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/rbte-portal
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=256M
TasksMax=16
TimeoutStartSec=400
