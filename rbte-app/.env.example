# The stub is the safe default and needs no external credentials.
AI_PROVIDER=stub
AI_STUB_LATENCY_MS=0

# Set these only in the server environment when the real provider is enabled.
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.6-terra
# OPENAI_TIMEOUT_MS=30000

# Test accounts are disabled unless explicitly enabled outside production.
RBTE_ENABLE_TEST_ACCOUNTS=false
RBTE_TEST_ACCOUNT_PASSWORD=
