# Environment variables for RBTE pilot
# Copy to .env.local and fill real values
DATABASE_URL="postgres://postgres:postgres@127.0.0.1:5432/rbte_pilot"

# Auth — Lucia, long random string
AUTH_SECRET="change-me-to-a-64-byte-random-string"

# Local development only. Never enable in a production process.
# PILOT_LOCAL_AUTH="1"
# PILOT_LOCAL_USER_ID="1"
# PILOT_LOCAL_USER_NAME="Local participant"

# AI provider used by RBTE Pilot
PILOT_OPENAI_API_KEY="sk-..."
PILOT_OPENAI_MODEL="gpt-4.1-mini"
PILOT_DILEMMA_OPENAI_MODEL="gpt-5.4"

# Server-to-server access to the knowledge MCP used for live FPF retrieval.
# The token is a service credential; never expose it to the browser.
RBTE_FPF_MCP_URL="https://mcp.aisystant.com/mcp"
RBTE_FPF_MCP_TOKEN="replace-with-server-mcp-token"
# Production: fail closed when a complete FPF source cannot be retrieved.
RBTE_REQUIRE_FPF_MCP="1"

# Knowledge packs (pinned)
FPF_COMMIT="3d098629dc218572089f1890080c17d6f1d9a867"
PACK_AL_COMMIT="a6a3140"
PACK_AL_EDITION="DPF-EDITION@pilot-2026-08-23.14"
PACK_TOC_COMMIT="replace-with-real-pack-toc-commit-hash-7chars"

# GitHub fine-grained PAT for reading private Victor57618/Pack-TOC repo
# Create: https://github.com/settings/tokens?type=beta → Only select repos: Victor57618/Pack-TOC → Contents: Read-only
GITHUB_READ_TOKEN="github_pat_11AAAaa1a0000replace_me_with_real_token"

# RBTE
RBTE_PILOT_EDITION="2026-08-23.14"
NEXT_PUBLIC_RBTE_PILOT="Лидер трансформации"
