{
  "name": "@rbte/app",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "mentor:evidence": "node scripts/build-mentor-evidence.mjs",
    "mentor:evidence:check": "node scripts/build-mentor-evidence.mjs --check",
    "prebuild": "npm run mentor:evidence:check",
    "build": "next build --webpack",
    "start": "next start -H 127.0.0.1 -p 8300",
    "lint": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "pretest": "npm run mentor:evidence:check",
    "test": "node --conditions=react-server --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "0.45.4",
    "lru-cache": "^11.0.2",
    "next": "16.4.5",
    "postgres": "^3.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.9.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "0.31.11",
    "postcss": "^8.4.49",
    "tailwindcss": "4.3.3",
    "tsx": "^4.20.0",
    "typescript": "^5.6.3"
  }
}
